+                                .join(subhost_storage::LEDGER_DIR_NAME)
+                                .join(subhost_storage::MANIFEST_FILE_NAME)
+                        )
+                        .unwrap(),
+                        manifests[index]
+                    );
+                }
+            }
+        }
+    }

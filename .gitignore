# Rust build artifacts
/target/
**/*.rs.bk

# Local node and wallet data — never commit key material or ledgers
/data/
*.node-state.bin
node-state.bin
genesis.json
faucet-wallet.json
wallets/

# Environment files
.env
.env.local
.env.*.local

# Editor and OS files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs and coverage
*.log
npm-debug.log*
/coverage/
*.profraw

# Internal working documents, kept local and deliberately untracked.
# PENTEST.md is an audit prompt for an LLM, not a published finding; publishing it
# advertises the exact review process and the areas known to be unfinished.
# PRESENTASI.md is a coursework presentation script naming presenters.
PENTEST.md
PRESENTASI.md

# Inter-agent discussion is workspace chat, not code. Both agents share this
# checkout, so questions and replies are written directly here and never staged:
# no branch, no commit, no PR. Only ADRs in docs/agents/decisions/ are tracked.
/docs/agents/questions/open/*.md
/docs/agents/questions/review/*.md
/docs/agents/questions/agreed/*.md
/docs/agents/questions/escalated/*.md
/docs/agents/replies/*.md
